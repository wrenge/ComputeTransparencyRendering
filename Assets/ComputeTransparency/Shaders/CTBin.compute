// Screen space binning: builds, for every tile, the list of triangles whose bounds overlap it.
// The list is packed into a single pool sized by a prefix sum over the per tile counts, so
// tiles that need many primitives can have them as long as the average stays within the pool.
//
// Each tile's slice is further divided into _CTSegmentCount sub-slices, one per range of the
// (depth ordered) triangle index space. Slots are still handed out atomically, so order inside
// a sub-slice is arbitrary, but a triangle can only ever land in the sub-slice its depth range
// owns. The result is a list that is sorted between segments by construction, which is what
// lets the raster sort one segment at a time instead of the whole list.
#pragma kernel CSClear
#pragma kernel CSCount
#pragma kernel CSTileTotals
#pragma kernel CSScanBlocks
#pragma kernel CSScanBlockSums
#pragma kernel CSScanAdd
#pragma kernel CSSegBase
#pragma kernel CSScatter

// Edge based tile reject and the tile coverage flag, compiled in or out rather than branched on:
// the choice is fixed for the whole dispatch, so a uniform branch would only cost the compiler the
// chance to drop the edge setup entirely. Every kernel in this file is compiled twice for it, but
// they are all small and only these two read it.
#pragma multi_compile _ CT_TILE_REJECT

#include "CTCommon.hlsl"

StructuredBuffer<CTTri> _CTTriangles;

RWStructuredBuffer<uint> _CTTileCount;      // raw overlap count per tile, before any clamping
RWStructuredBuffer<uint> _CTTileTotal;      // kept count per tile, the input to the prefix sum
RWStructuredBuffer<uint> _CTTileOffset;     // start of the tile's slice in _CTTileList
RWStructuredBuffer<uint> _CTTileEnd;        // one past the tile's last slot, absolute
RWStructuredBuffer<uint> _CTTileSegCount;   // kept count per (tile, segment)
RWStructuredBuffer<uint> _CTTileSegBase;    // absolute start of the (tile, segment) sub-slice
RWStructuredBuffer<uint> _CTTileSegCursor;  // scatter write cursor per (tile, segment)
RWStructuredBuffer<uint> _CTBlockSums;      // per scan block totals, then block base offsets
RWStructuredBuffer<uint> _CTTileList;       // the pool of triangle indices

uint4 _CTTileParams;      // x = tilesX, y = tilesY, z = tileCount, w = block count
uint  _CTTriCount;
uint  _CTTileListCapacity;
uint  _CTTileSize;        // tile edge in pixels, a renderer feature setting
uint  _CTSegmentCount;    // active segments, 1 .. CT_MAX_SEGMENTS
float4 _CTScreenSize;     // xy = pixels, zw = 1/pixels

groupshared uint gsScan[CT_SCAN_GROUP];

// Tile range covered by a triangle's screen space bounds, clamped to the screen.
bool TriTileRange(CTTri t, out uint2 tileLo, out uint2 tileHi)
{
    tileLo = 0;
    tileHi = 0;
    if (!CTTriValid(t))
        return false;

    float2 lo, hi;
    CTTriBounds(t, lo, hi);
    lo = max(lo, 0.0);
    hi = min(hi, _CTScreenSize.xy - 1.0);
    if (any(lo > hi))
        return false;

    tileLo = (uint2)(lo / _CTTileSize);
    tileHi = (uint2)(hi / _CTTileSize);
    tileHi = min(tileHi, _CTTileParams.xy - 1);
    return true;
}

[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i < _CTTileParams.z * _CTSegmentCount)
        _CTTileSegCount[i] = 0;
    if (i < _CTTileParams.w)
        _CTBlockSums[i] = 0;
}

// Counting and scattering have to agree tile for tile, so both walk the bounding box range and
// both run the same edge test on each tile in it. The bounding box on its own is a poor filter
// here: a sprite is two triangles sharing the quad's diagonal, so each of them has the quad's
// bounds and every tile the quad touches gets both halves even though roughly half of each
// tile's list can produce no pixel at all.
[numthreads(64, 1, 1)]
void CSCount(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _CTTriCount)
        return;

    CTTri t = _CTTriangles[i];

    uint2 tileLo, tileHi;
    if (!TriTileRange(t, tileLo, tileHi))
        return;

#ifdef CT_TILE_REJECT
    CTTileEdges edges = CTBuildTileEdges(t, (float)_CTTileSize);
#endif

    uint seg = CTSegmentOf(i, _CTTriCount, _CTSegmentCount);

    for (uint ty = tileLo.y; ty <= tileHi.y; ty++)
    {
        uint row = ty * _CTTileParams.x;
        for (uint tx = tileLo.x; tx <= tileHi.x; tx++)
        {
#ifdef CT_TILE_REJECT
            if (CTClassifyTile(edges, uint2(tx, ty), (float)_CTTileSize) == CT_TILE_OUTSIDE)
                continue;
#endif
            uint prev;
            InterlockedAdd(_CTTileSegCount[(row + tx) * _CTSegmentCount + seg], 1, prev);
        }
    }
}

// Turns the per segment counts into the tile's kept total and each segment's offset within the
// tile. Each segment gets its own budget, so a tile that runs out of room drops the surplus of
// whichever depth ranges are crowded rather than an arbitrary set of primitives, which is what
// the atomic scatter used to do.
[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSTileTotals(uint3 id : SV_DispatchThreadID)
{
    uint tile = id.x;
    if (tile >= _CTTileParams.z)
        return;

    uint base = tile * _CTSegmentCount;
    uint raw = 0;
    uint total = 0;

    for (uint s = 0; s < _CTSegmentCount; s++)
    {
        uint c = _CTTileSegCount[base + s];
        raw += c;

        uint keep = min(c, CT_MAX_SEG_PRIMS);
        _CTTileSegCount[base + s] = keep;
        _CTTileSegBase[base + s] = total;   // relative to the tile, made absolute by CSSegBase
        total += keep;
    }

    _CTTileCount[tile] = raw;
    _CTTileTotal[tile] = total;
}

// Exclusive scan inside one block of CT_SCAN_GROUP tiles, plus the block total.
[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSScanBlocks(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint tid : SV_GroupIndex)
{
    uint i = id.x;
    uint v = (i < _CTTileParams.z) ? _CTTileTotal[i] : 0;
    gsScan[tid] = v;
    GroupMemoryBarrierWithGroupSync();

    for (uint offset = 1; offset < CT_SCAN_GROUP; offset <<= 1)
    {
        uint add = (tid >= offset) ? gsScan[tid - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gsScan[tid] += add;
        GroupMemoryBarrierWithGroupSync();
    }

    if (i < _CTTileParams.z)
        _CTTileOffset[i] = gsScan[tid] - v;
    if (tid == CT_SCAN_GROUP - 1)
        _CTBlockSums[gid.x] = gsScan[tid];
}

// Turns the block totals into block base offsets. One group walks all blocks, so this works for
// any screen size instead of being capped at CT_SCAN_GROUP blocks.
[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSScanBlockSums(uint tid : SV_GroupIndex)
{
    uint blockCount = _CTTileParams.w;
    uint chunk = (blockCount + CT_SCAN_GROUP - 1) / CT_SCAN_GROUP;
    uint start = tid * chunk;

    uint sum = 0;
    for (uint j = 0; j < chunk; j++)
    {
        uint idx = start + j;
        if (idx < blockCount)
            sum += _CTBlockSums[idx];
    }

    gsScan[tid] = sum;
    GroupMemoryBarrierWithGroupSync();
    for (uint offset = 1; offset < CT_SCAN_GROUP; offset <<= 1)
    {
        uint add = (tid >= offset) ? gsScan[tid - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gsScan[tid] += add;
        GroupMemoryBarrierWithGroupSync();
    }

    uint run = gsScan[tid] - sum;
    for (uint k = 0; k < chunk; k++)
    {
        uint idx = start + k;
        if (idx < blockCount)
        {
            uint v = _CTBlockSums[idx];
            _CTBlockSums[idx] = run;
            run += v;
        }
    }
}

[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSScanAdd(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _CTTileParams.z)
        return;
    _CTTileOffset[i] += _CTBlockSums[i / CT_SCAN_GROUP];
}

// Now that the tile's slice has an absolute address, give every segment its own absolute
// sub-slice and point its scatter cursor at the start of it.
[numthreads(CT_SCAN_GROUP, 1, 1)]
void CSSegBase(uint3 id : SV_DispatchThreadID)
{
    uint tile = id.x;
    if (tile >= _CTTileParams.z)
        return;

    uint offset = _CTTileOffset[tile];
    uint base = tile * _CTSegmentCount;

    for (uint s = 0; s < _CTSegmentCount; s++)
    {
        uint absolute = offset + _CTTileSegBase[base + s];
        _CTTileSegBase[base + s] = absolute;
        _CTTileSegCursor[base + s] = absolute;
    }

    _CTTileEnd[tile] = offset + _CTTileTotal[tile];
}

// Writes triangle indices into the pool. Slots inside one segment are still handed out
// atomically, so a segment comes out unordered and the raster sorts it; but a triangle can only
// land in the sub-slice its depth range owns, so the segments themselves are in depth order.
[numthreads(64, 1, 1)]
void CSScatter(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _CTTriCount)
        return;

    CTTri t = _CTTriangles[i];

    uint2 tileLo, tileHi;
    if (!TriTileRange(t, tileLo, tileHi))
        return;

#ifdef CT_TILE_REJECT
    CTTileEdges edges = CTBuildTileEdges(t, (float)_CTTileSize);
#endif

    uint seg = CTSegmentOf(i, _CTTriCount, _CTSegmentCount);

    for (uint ty = tileLo.y; ty <= tileHi.y; ty++)
    {
        uint row = ty * _CTTileParams.x;
        for (uint tx = tileLo.x; tx <= tileHi.x; tx++)
        {
            // The other half of the same classify: a tile the triangle covers completely is
            // flagged in the entry, and the raster takes every pixel in it without testing.
#ifdef CT_TILE_REJECT
            uint cls = CTClassifyTile(edges, uint2(tx, ty), (float)_CTTileSize);
            if (cls == CT_TILE_OUTSIDE)
                continue;
            uint covered = (cls == CT_TILE_COVERED) ? 1u : 0u;
#else
            uint covered = 0;
#endif

            uint idx = (row + tx) * _CTSegmentCount + seg;
            uint dst;
            InterlockedAdd(_CTTileSegCursor[idx], 1, dst);

            uint segEnd = _CTTileSegBase[idx] + _CTTileSegCount[idx];
            if (dst < segEnd && dst < _CTTileListCapacity)
                _CTTileList[dst] = CTPackEntry(i, covered);
        }
    }
}
